# frc-dashboard configuration — see config/help.toml for field docs.
# Station identity defaults to /etc/sigmond/coordination.env (STATION_*);
# MongoDB credentials come from /etc/frc-contesting/mongodb.env.

[server]
bind = "0.0.0.0"
port = 5000
workers = 2
threads = 4
timeout_sec = 120

[station]
callsign = ""
grid_square = ""

[app]
root = ""

[waterfall]
enabled = true
radiod_status = ""
bands = "160m,80m,40m,20m,15m,10m"
bins = 800
poll_sec = 2.0
averaging = 2
idle_timeout_sec = 60
history_rows = 1800

[listen]
enabled = true
max_listeners = 2
idle_timeout_sec = 15

[skimmer]
enabled = true
bands = "40m,20m"
band = "20m"
idle_timeout_sec = 120
always_on = false
detect_db = 9.0
max_signals = 40
max_rtty_signals = 30
store = true
database = "skimmer_db"
retention_days = 90
spotter = ""
scp_file = ""
telnet_port = 0
telnet_bind = "127.0.0.1"
