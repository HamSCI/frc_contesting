# MongoDB Configuration
# Copy this file to .env and fill in your actual credentials
# WARNING: Never commit .env to git! It's in .gitignore for a reason.

# MongoDB Connection Settings
MONGODB_HOST=your_mongodb_host
MONGODB_PORT=27017
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_DATABASE=wspr_db

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Receiver Station Configuration
# Callsign of the PSWS receiver station
RECEIVER_CALLSIGN=KD3ALD
# Maidenhead grid square of the receiver (4 or 6 character)
RECEIVER_GRIDSQUARE=FN21ni

# ITU-R HF Propagation Engine
# Optional: directory containing a custom/modified ionosphere data set
# (ionosNN.bin, COEFFNNW.txt, "P1239-3 Decile Factors.txt", ...).
# Seed it with:  python scripts/seed_custom_ionosphere.py
# Relative paths resolve against the repo root. On Windows use a
# Windows-style path (converted to /mnt/... for WSL automatically);
# do NOT use a /mnt/... path here. If unset or invalid, the bundled
# reference data in itu_r_hf/ITURHFProp/Data/ is used. Requires an app
# restart to take effect.
# ITURHF_DATA_PATH=ionosphere/custom

# Assimilated-Predictions [BETA]
# Minutes a fresh assimilation session shows "Baseline" before the indicator
# flips to "Assimilated" (default 15). Accepts fractions for testing (e.g. 0.1).
# ASSIMILATION_WARMUP_MINUTES=15
# Minutes of inactivity after which a session is considered stale and the
# assimilated working copy is reset to a fresh baseline copy (default 30).
# ASSIMILATION_STALE_MINUTES=30

# Optional: Alternate MongoDB servers (uncomment to use)
# MONGODB_HOST=localhost
# MONGODB_PORT=5007
