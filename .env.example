# MongoDB Configuration
# Copy this file to .env and fill in your actual credentials
# WARNING: Never commit .env to git! It's in .gitignore for a reason.

# MongoDB Connection Settings
MONGODB_HOST=your_mongodb_host
MONGODB_PORT=27017
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_DATABASE=wspr_db

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Receiver Station Configuration
# Callsign of the PSWS receiver station
RECEIVER_CALLSIGN=KD3ALD
# Maidenhead grid square of the receiver (4 or 6 character)
RECEIVER_GRIDSQUARE=FN21ni

# Optional: Alternate MongoDB servers (uncomment to use)
# MONGODB_HOST=localhost
# MONGODB_PORT=5007
