# MongoDB Configuration
# Copy this file to .env and fill in your actual credentials
# WARNING: Never commit .env to git! It's in .gitignore for a reason.

# MongoDB Connection Settings
MONGODB_HOST=your_mongodb_host
MONGODB_PORT=27017
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_DATABASE=wspr_db

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
# Port the dev server listens on (only used by `python web-ft.py`)
FLASK_PORT=5000

# Receiver Station Configuration
# Callsign of the PSWS receiver station
RECEIVER_CALLSIGN=KD3ALD
# Maidenhead grid square of the receiver (4 or 6 character)
RECEIVER_GRIDSQUARE=FN21ni

# Optional: Alternate MongoDB servers (uncomment to use)
# MONGODB_HOST=localhost
# MONGODB_PORT=5007

# Optional: space weather from NOAA SWPC (fetched by this server; needs internet
# at the server, never in the browser). 0 turns it off entirely.
# SPACEWX_ENABLED=1

# Optional: hf-timestd database for the Local PSWS panel (WWV/WWVH Doppler).
# If missing or unrecognised, that part of the panel is hidden.
# TIMESTD_DB=/var/lib/timestd/phase2/timestd.db
